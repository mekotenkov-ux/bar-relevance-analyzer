# Runtime configuration template. For local Cloudflare development, copy the
# required values to an ignored `.dev.vars` file. In production, configure API
# keys and tokens as runtime secrets; never add them to Vite build variables.
SITE_URL=http://localhost:3000

XMLRIVER_USER=
XMLRIVER_KEY=
FIRECRAWL_API_KEY=

# Optional local E5 service for N-gram-to-key semantic similarity. When it is
# absent or unavailable, BAR keeps the deterministic built-in fallback.
# PHRASE_EMBEDDINGS_URL=http://127.0.0.1:8093
PHRASE_EMBEDDINGS_URL=
PHRASE_EMBEDDINGS_TIMEOUT_MS=300000
PHRASE_EMBEDDINGS_CHUNK_SIZE=512
