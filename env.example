# Runtime configuration template. For local Cloudflare development, copy the
# required values to an ignored `.dev.vars` file. In production, configure API
# keys and tokens as runtime secrets; never add them to Vite build variables.
SITE_URL=https://example.com

XMLRIVER_USER=
XMLRIVER_KEY=
FIRECRAWL_API_KEY=

# Optional semantic-relations module. The UI option still controls whether a
# report invokes it; spaCy is the default engine when the option is enabled.
TRIPLET_ENGINE=spacy
TRIPLET_SPACY_URL=http://127.0.0.1:8092
TRIPLET_SPACY_TIMEOUT_MS=900000
# Emergency transport guard; this is not a report-row limit.
TRIPLET_SPACY_MAX_REQUEST_CHARACTERS=128000000

# Explicitly set TRIPLET_ENGINE=llm to use the archived LLM experiment.
# TRIPLET_API_URL=
# TRIPLET_MODEL=
# TRIPLET_API_KEY=
