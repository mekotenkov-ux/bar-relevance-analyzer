# Adapter address. It binds to loopback by default.
TRIPLETS_BIND_HOST=127.0.0.1
TRIPLETS_PORT=8091

# Optional inbound Bearer token shared with the BAR web application.
# Generate and store the real value only in your local .env or secret manager.
TRIPLETS_API_TOKEN=

# OpenAI-compatible backend. Defaults to the llama.cpp container in this Compose file.
TRIPLETS_LLM_BASE_URL=http://llama:8080/v1
TRIPLETS_LLM_MODEL=NuExtract-2.0-2B-Q4_K_M.gguf
TRIPLETS_LLM_API_KEY=

# llama.cpp downloads this model into the named Docker volume, never into the repository.
TRIPLETS_MODEL_SOURCE=numind/NuExtract-2.0-2B-GGUF:Q4_K_M
TRIPLETS_LLM_PORT=8080
TRIPLETS_LLM_CONTEXT_SIZE=24576
TRIPLETS_LLM_PARALLEL=2
TRIPLETS_LLM_THREADS=8
TRIPLETS_LLM_THREADS_BATCH=8
TRIPLETS_LLM_BATCH_SIZE=512
TRIPLETS_LLM_UBATCH_SIZE=128
TRIPLETS_LLM_MEMORY_LIMIT=4g
TRIPLETS_LLM_CPUS=8.0

# Adapter safeguards. Compiled hard caps cannot be raised through environment variables.
TRIPLETS_MAX_CONCURRENCY=2
TRIPLETS_MAX_QUEUE_WAIT_SECONDS=30
TRIPLETS_REQUEST_TIMEOUT_SECONDS=180
TRIPLETS_HEALTH_TIMEOUT_SECONDS=5
TRIPLETS_MAX_REQUEST_BYTES=196608
TRIPLETS_MAX_ENTITIES=64
TRIPLETS_MAX_FOCUS_ENTITIES=20
TRIPLETS_MAX_SENTENCES=250
TRIPLETS_MAX_INPUT_TOKENS=6000
TRIPLETS_MAX_EDGES=64
TRIPLETS_MAX_OUTPUT_TOKENS=2048
TRIPLETS_ADAPTER_MEMORY_LIMIT=512m
TRIPLETS_ADAPTER_CPUS=1.0

# NuExtract uses a JSON extraction template. Disable this when swapping to a generic Qwen model.
TRIPLETS_USE_NUEXTRACT_TEMPLATE=true
TRIPLETS_RESPONSE_FORMAT=none
TRIPLETS_REQUIRE_VERBATIM_PREDICATE=true
