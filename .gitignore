# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Runtime secrets and local environment files
.env*
/.dev.vars*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/artifacts/
*.tsbuildinfo

# Python helper services
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
services/triplets-symbolic/.venv/
services/triplets-symbolic/.stanza-models/
services/triplets-symbolic/results/

# Local model weights
*.gguf
*.safetensors
*.onnx
*.pt
*.pth

# local preview logs
dev-output.log
dev-error.log
